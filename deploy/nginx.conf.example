# Configuracion de nginx para el VPS de andesmp.site (64.176.25.112).
# Copiar a /etc/nginx/sites-available/andesmp y enlazar en sites-enabled:
#
#   sudo ln -s /etc/nginx/sites-available/andesmp /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# TLS (los tres subdominios de una sola vez):
#   sudo certbot --nginx -d andesmp.site -d api.andesmp.site -d vtc.andesmp.site
# certbot reescribe este archivo anadiendo los bloques 443 y el redirect 80->443.
# NOTA: no incluyas -d www.andesmp.site mientras no exista ese registro en Route 53,
# certbot falla la validacion y no emite NINGUN certificado.

# =============================================================================
#  andesmp.site  ->  landing estatica (build de Vite)
# =============================================================================
server {
    listen 80;
    listen [::]:80;
    server_name andesmp.site;

    root /var/www/andesmp/dist;
    index index.html;

    # --- Rutas SPA -----------------------------------------------------------
    # Sin esto, entrar directo a /reglas o /recursos devuelve 404: esos ficheros
    # no existen en disco, las rutas las resuelve react-router en el navegador.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # --- Cache ---------------------------------------------------------------
    # Vite pone un hash en el nombre de cada asset, asi que se pueden cachear
    # para siempre sin miedo a servir una version vieja.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # index.html nunca se cachea, es quien apunta a los assets con hash nuevo.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # --- Compresion ----------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    # Las .webp ya vienen comprimidas: recomprimirlas solo gasta CPU.

    # --- Cabeceras de seguridad ---------------------------------------------
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}

# =============================================================================
#  api.andesmp.site  ->  proxy inverso al backend
#  La API escucha en 127.0.0.1:3001 (ver .env de los proyectos).
# =============================================================================
server {
    listen 80;
    listen [::]:80;
    server_name api.andesmp.site;

    # Los lotes de telemetria rondan los 200 KB. 2 MB deja margen sin permitir
    # un cuerpo arbitrariamente grande (mismo limite que tenia el Caddyfile).
    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;

        # Necesario para WebSockets (si la API los usa).
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 300s;
    }
}

# =============================================================================
#  vtc.andesmp.site  ->  front VTC (Next.js standalone, servicio systemd 'vtc')
#  Escucha en 127.0.0.1:3000. No es estatico: es un proceso Node, no un root.
# =============================================================================
server {
    listen 80;
    listen [::]:80;
    server_name vtc.andesmp.site;

    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}

# =============================================================================
#  Catch-all: cualquier peticion por IP o con Host desconocido se cierra.
#  Evita que 64.176.25.112 sirva la landing y que bots enganchen por Host raro.
# =============================================================================
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}
