# PostHog. Copia este archivo a .env.local y rellena la clave.
# La clave "project API key" es publica por diseno: viaja en el bundle del
# navegador. No pongas aqui la personal API key.
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# us.i.posthog.com o eu.i.posthog.com segun donde crees el proyecto.
VITE_POSTHOG_HOST=https://us.i.posthog.com
